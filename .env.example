# Copy this file to `.env` and fill in the values from your Supabase project
# dashboard (Project Settings -> API). Never commit `.env` itself.

# Safe to expose: the anon key only works together with Row Level Security.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# NOTE: SUPABASE_SERVICE_ROLE_KEY is deliberately absent.
# That key bypasses RLS entirely and must never reach this application.
# See CLAUDE.md, security rule #3.
